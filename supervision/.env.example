# Modele de configuration. Copier en .env et renseigner les vraies valeurs.
# Le fichier .env reel n'est PAS versionne (il contient le mot de passe).

# Connexion de l'exporteur a PostgreSQL (base locale sur le port 5433).
PG_EXPORTER_DSN=postgresql://dbt_user:MOT_DE_PASSE@127.0.0.1:5433/datawarehouse_e6?sslmode=disable

# Mot de passe administrateur de Grafana (compte admin).
GRAFANA_ADMIN_PASSWORD=choisir_un_mot_de_passe
